// Lately Lebanon database schema.
// Money is stored as integer cents (USD). Commission percentages use Decimal(5,2).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  HANDED_TO_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  CARD
  WHISH
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum PromoType {
  PERCENT
  FIXED
}

enum AdminRole {
  OWNER
  EDITOR
}

model Brand {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(120)
  slug          String   @unique @db.VarChar(140)
  logoKey       String?  @db.VarChar(255)
  coverKey      String?  @db.VarChar(255)
  story         String   @db.Text
  instagramUrl  String?  @db.VarChar(255)
  // Internal only, never sent to public endpoints.
  contactName   String?  @db.VarChar(120)
  phone         String?  @db.VarChar(40)
  email         String?  @db.VarChar(190)
  commissionPct Decimal  @default(20) @db.Decimal(5, 2)
  // On: the brand delivers its own products, at its prices in BrandDeliveryFee.
  ownDelivery   Boolean  @default(false)
  internalNotes String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products        Product[]
  orderItems      OrderItem[]
  payouts         BrandPayout[]
  deliveryFees    BrandDeliveryFee[]
  orderDeliveries OrderBrandDelivery[]

  @@index([isActive])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(140)
  imageKey  String?  @db.VarChar(255)
  parentId  Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
}

model Product {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(160)
  slug           String        @unique @db.VarChar(140)
  brandId        Int
  categoryId     Int
  description    String        @db.Text
  priceCents     Int
  compareAtCents Int?
  // Overrides the brand's default commission when set.
  commissionPct  Decimal?      @db.Decimal(5, 2)
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  /// string[]
  tags           Json
  /// { name: string; values: string[] }[]
  options        Json
  seoTitle       String?       @db.VarChar(160)
  seoDescription String?       @db.VarChar(320)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brand      Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([status, publishedAt])
  @@index([brandId, status])
  @@index([categoryId, status])
  @@index([featured, status])
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int
  /// Record<string, string>, for example { "Size": "M", "Colour": "Olive" }. Empty for the default variant.
  options    Json
  label      String   @default("") @db.VarChar(160)
  sku        String?  @unique @db.VarChar(64)
  priceCents Int?
  stock      Int      @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId, sortOrder])
  @@index([stock])
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  key       String @db.VarChar(255)
  alt       String @default("") @db.VarChar(200)
  width     Int
  height    Int
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Order {
  id               Int           @id @default(autoincrement())
  number           String        @unique @db.VarChar(16)
  customerName     String        @db.VarChar(120)
  phone            String        @db.VarChar(20)
  email            String?       @db.VarChar(190)
  city             String        @db.VarChar(80)
  // Delivery zone name copied at purchase time.
  region           String        @db.VarChar(80)
  deliveryZoneId   Int?
  address          String        @db.Text
  notes            String?       @db.Text
  subtotalCents    Int
  // Our fee plus any brand delivery fees (see OrderBrandDelivery).
  deliveryFeeCents Int
  discountCents    Int           @default(0)
  totalCents       Int
  promoCodeId      Int?
  promoCode        String?       @db.VarChar(40)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(UNPAID)
  status           OrderStatus   @default(NEW)
  stockReleased    Boolean       @default(false)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  deliveryZone    DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  promo           PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  events          OrderStatusEvent[]
  brandDeliveries OrderBrandDelivery[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod, paymentStatus, createdAt])
  @@index([phone])
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  productId      Int
  variantId      Int?
  brandId        Int
  // Copied at the moment of purchase and never recalculated.
  productName    String  @db.VarChar(160)
  variantLabel   String  @default("") @db.VarChar(160)
  quantity       Int
  unitPriceCents Int
  commissionPct  Decimal @db.Decimal(5, 2)
  lineTotalCents Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  brand   Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([brandId])
  @@index([productId])
}

model OrderStatusEvent {
  id          Int         @id @default(autoincrement())
  orderId     Int
  status      OrderStatus
  note        String?     @db.VarChar(500)
  adminUserId Int?
  createdAt   DateTime    @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id          Int                  @id @default(autoincrement())
  orderId     Int
  provider    PaymentMethod
  amountCents Int
  status      PaymentAttemptStatus @default(PENDING)
  providerRef String?              @db.VarChar(190)
  raw         Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider, providerRef])
}

model BrandPayout {
  id          Int      @id @default(autoincrement())
  brandId     Int
  amountCents Int
  paidAt      DateTime @db.Date
  method      String   @db.VarChar(60)
  note        String?  @db.VarChar(500)
  createdById Int?
  createdAt   DateTime @default(now())

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([brandId, paidAt])
}

model DeliveryZone {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  feeCents  Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  brandFees BrandDeliveryFee[]
}

// A brand's own delivery price for one of our delivery areas. Only used while the
// brand's ownDelivery is on. No row for an area means we deliver there at our fee.
model BrandDeliveryFee {
  brandId  Int
  zoneId   Int
  feeCents Int

  brand Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  zone  DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([brandId, zoneId])
  @@index([zoneId])
}

// A brand that delivered its own items on an order, and the fee it charged.
// Copied at purchase time. The fee is owed to the brand.
model OrderBrandDelivery {
  id       Int @id @default(autoincrement())
  orderId  Int
  brandId  Int
  feeCents Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([orderId, brandId])
  @@index([brandId])
}

model PromoCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(40)
  type          PromoType
  // Percent (1 to 100) for PERCENT, cents for FIXED.
  value         Int
  minOrderCents Int       @default(0)
  expiresAt     DateTime?
  usageLimit    Int?
  timesUsed     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders Order[]
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(190)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions    AdminSession[]
  orderEvents OrderStatusEvent[]
  payouts     BrandPayout[]
}

model AdminSession {
  // SHA-256 of the session token stored in the cookie.
  id        String   @id @db.VarChar(64)
  userId    Int
  csrfToken String   @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?  @db.VarChar(255)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Settings {
  id                         Int      @id @default(1)
  storeName                  String   @default("Lately Lebanon") @db.VarChar(80)
  whatsappNumber             String?  @db.VarChar(20)
  whatsappNumber2            String?  @db.VarChar(20)
  contactEmail               String   @db.VarChar(190)
  instagramUrl               String?  @db.VarChar(255)
  freeDeliveryThresholdCents Int?
  announcementText           String?  @db.VarChar(200)
  announcementActive         Boolean  @default(false)
  heroHeading                String   @db.VarChar(120)
  heroText                   String   @db.VarChar(400)
  heroImageKey               String?  @db.VarChar(255)
  aboutImageKey              String?  @db.VarChar(255)
  /// number[]
  featuredBrandIds           Json
  /// number[]
  featuredProductIds         Json
  updatedAt                  DateTime @updatedAt
}
