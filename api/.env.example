# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Use Beirut time for "today" and "this month" on the dashboard.
TZ=Asia/Beirut

# ---------- Database ----------
# Keep connection_limit small: Hostinger allows 75 MySQL connections in total.
DATABASE_URL="mysql://latelylebanon:password@localhost:3306/latelylebanon?connection_limit=5"

# ---------- URLs ----------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# In production set this to .latelylebanon.com so the admin cookie works on both subdomains.
COOKIE_DOMAIN=
SESSION_TTL_DAYS=14

# ---------- Uploads ----------
# local (default) or s3
UPLOAD_DRIVER=local
# Keep this OUTSIDE the app folder so redeploys never delete photos.
# On Hostinger, for example: /home/u123456789/latelylebanon-uploads
UPLOAD_DIR=../uploads
# Optional. Defaults to ${API_ORIGIN}/uploads for the local driver. Required for s3.
UPLOADS_PUBLIC_URL=
# Only for UPLOAD_DRIVER=s3 (for example Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Email (Hostinger mailbox) ----------
# Leave SMTP_HOST empty in development: emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@latelylebanon.com
SMTP_PASS=
MAIL_FROM="Lately Lebanon <orders@latelylebanon.com>"
ADMIN_NOTIFY_EMAIL=hello@latelylebanon.com

# ---------- Secrets ----------
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-to-a-long-random-string
# Must match REVALIDATE_SECRET in web/.env
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-another-long-random-string

# ---------- First owner account (used by the seed script) ----------
SEED_OWNER_NAME="Lately Lebanon Owner"
SEED_OWNER_EMAIL=owner@latelylebanon.com
SEED_OWNER_PASSWORD=change-me-please
# Set to false in production to create only the owner account, without the sample makers and products.
SEED_SAMPLE_CATALOG=true

# ---------- Payments ----------
# Cash on delivery is always on. Card and Whish are switched on here.
PAYMENT_CARD_ENABLED=false
MPGS_GATEWAY_URL=https://ap-gateway.mastercard.com
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_API_VERSION=100
MPGS_WEBHOOK_SECRET=

PAYMENT_WHISH_ENABLED=false
WHISH_API_URL=https://api.whish.money/itel-service/api
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=
