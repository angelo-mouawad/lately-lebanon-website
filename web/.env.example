# Public URL of the storefront (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the API, used by the browser (admin panel, search, cart, checkout)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: URL the Next.js server uses to reach the API. Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Must match REVALIDATE_SECRET in api/.env. Lets the API refresh cached pages after admin edits.
REVALIDATE_SECRET=change-me-to-another-long-random-string
